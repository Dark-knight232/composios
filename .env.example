# Required
COMPOSIO_API_KEY=your_composio_api_key_here

# Use one LLM provider (NVIDIA NIM is supported and preferred)
NIM_API_KEY=your_nvidia_nim_api_key_here
NIM_API_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Alternative LLM providers (uncomment one)
OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Tavily API key (required for direct Tavily search calls when MCP connections unavailable)
TAVILY_API_KEY=your_tavily_api_key_here